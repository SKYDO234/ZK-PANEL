{
  "name": "zk-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZK PANEL — a unified home for games, containers, websites and bots.",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts agent/index.ts bot/index.ts bot/register.ts scripts/create-admin.ts scripts/import-ziyn.ts --bundle --platform=node --format=esm --packages=external --outbase=. --outdir=dist --out-extension:.js=.mjs",
    "start": "node dist/server/index.mjs",
    "agent": "tsx agent/index.ts",
    "bot": "tsx bot/index.ts",
    "bot:register": "tsx bot/register.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsx scripts/create-admin.ts",
    "ziyn:import": "tsx scripts/import-ziyn.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/space-grotesk": "^5.2.8",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.22.1",
    "dockerode": "^5.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "recharts": "^3.1.0",
    "stripe": "^18.4.0",
    "tar": "^7.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/dockerode": "^3.3.42",
    "@types/express": "^4.17.23",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.8",
    "prettier": "^3.9.10",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
