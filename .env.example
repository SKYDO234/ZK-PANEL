# Demo works without any credentials. Docker mode never falls back to demo.
ZK_MODE=demo
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# REQUIRED in Docker mode: openssl rand -hex 48
SESSION_SECRET=
COOKIE_SECURE=false
ALLOW_REGISTRATION=false
MAX_SERVERS_PER_USER=20

# Local Docker (dedicated host only; socket access is root-equivalent)
ZK_REMOTE_ONLY=false
DOCKER_SOCKET=/var/run/docker.sock
# Must be the REAL HOST path corresponding to DATA_DIR/workspaces.
WORKSPACE_HOST_PATH=/opt/zk/data/workspaces
NODE_REGION=Mumbai
NODE_COUNTRY=IN
NODE_DISK_MB=102400
# Administrator-approved exact image tags. Pin reviewed digests for production.
IMAGE_ALLOWLIST=itzg/minecraft-server:java21,itzg/minecraft-bedrock-server:latest,itzg/mc-proxy:java21,node:22-alpine,python:3.12-alpine,nginxinc/nginx-unprivileged:1.27-alpine,alpine:3.22,redis:7.4-alpine

# Remote node agent: run on the Docker host, behind TLS.
NODE_TOKEN=
AGENT_PORT=8080

# Stripe: real INR checkout; no client-side payment confirmation is trusted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Discord companion: run bot:register once, then bot.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: instant registration to one test guild; omit for global commands.
DISCORD_GUILD_ID=

# Demo login controls (demo mode only).
# Set ZK_DEMO_AUTO_LOGIN=false to require a login instead of automatic demo entry.
ZK_DEMO_AUTO_LOGIN=true
ZK_DEV_BOOTSTRAP=false
# Only needed when testing the guarded demo bootstrap outside GitHub Codespaces.
ZK_ALLOW_LOCAL_DEV_BOOTSTRAP=false

# Real-runtime Codespaces bootstrap (install.sh sets these automatically).
# Requires ZK_MODE=docker, ZK_REMOTE_ONLY=false, and CODESPACES=true
# (or the explicit local testing override below). Creates admin/admin123 once.
ZK_CODESPACES_BOOTSTRAP=false
ZK_ALLOW_LOCAL_CODESPACES_BOOTSTRAP=false

# Optional local Playit integration: administrator-installed trusted agent binary.
# PLAYIT_BINARY=/absolute/path/to/playit
# Set on a remote node agent only when it shares the Docker host's network.
# PLAYIT_HOST_NETWORK=true
